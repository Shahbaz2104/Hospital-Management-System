generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Auth & Identity
// ============================================================================

model Hospital {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  slug                String   @unique
  email               String?
  phone               String?
  address             String?
  city                String?
  country             String?
  logoUrl             String?
  currency            String   @default("USD")
  taxRate             Float    @default(0)
  timezone            String   @default("Asia/Kolkata")
  workingHoursStart   String   @default("09:00")
  workingHoursEnd     String   @default("17:00")
  appointmentDuration Int      @default(15)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users    User[]
  roles    Role[]
  settings Settings[]
}

model User {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  email              String   @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  title              String?
  avatarUrl          String?
  roleId             String   @db.ObjectId
  role               Role     @relation(fields: [roleId], references: [id])
  hospitalId         String?  @db.ObjectId
  hospital           Hospital? @relation(fields: [hospitalId], references: [id])
  status             String   @default("ACTIVE") // ACTIVE | SUSPENDED | PENDING
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  emailVerified      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  doctor        Doctor?
  nurse         Nurse?
  employee      Employee?
  patient       Patient[]

  @@index([roleId])
}

// ============================================================================
// Master data: departments, clinical staff, rooms & beds
// ============================================================================

model Patient {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  patientNo          String   @unique // auto-generated e.g. PT-0001
  userId             String?  @db.ObjectId
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName          String
  lastName           String
  dob                DateTime?
  gender             String? // MALE | FEMALE | OTHER
  bloodGroup         String? // A+ | A- | B+ | B- | AB+ | AB- | O+ | O-
  phone              String?
  email              String?
  address            String?
  city               String?
  emergencyContact   String?
  heightCm           Float?
  weightKg           Float?
  allergies          String? // comma-separated
  medicalHistory     String?
  previousDiseases   String?
  currentMedication  String?
  vaccinationHistory String?
  insuranceProvider  String?
  insuranceNumber    String?
  insurancePlan      String?
  insuranceExpiry    DateTime?
  documents          String? // JSON array of {name, url}
  status             String   @default("ACTIVE") // ACTIVE | INACTIVE
  hospitalId         String?  @db.ObjectId
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  appointments Appointment[]
  admissions   Admission[]

  @@index([status])
}

model Appointment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenNo       String   @unique // e.g. TKN-0001 (OPD queue)
  patientId     String   @db.ObjectId
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?  @db.ObjectId
  doctor        Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  departmentId  String?  @db.ObjectId
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  date          DateTime @db.Date
  startTime     String // "HH:mm"
  endTime       String
  type          String   @default("WALKIN") // ONLINE | WALKIN | FOLLOWUP
  status        String   @default("PENDING") // PENDING | CONFIRMED | COMPLETED | CANCELLED | MISSED
  reason        String?
  notes         String?
  createdById   String?  @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([status])
}

model Department {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  code        String   @unique
  description String?
  headDoctorId String? @db.ObjectId
  headDoctor  Doctor?  @relation("DepartmentHead", fields: [headDoctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hospitalId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors   Doctor[]
  nurses    Nurse[]
  employees Employee[]
  rooms     Room[]
  appointments Appointment[]
}

model Doctor {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId    String?  @db.ObjectId
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  headOf          Department[] @relation("DepartmentHead")
  specialization  String?
  qualification   String?
  experienceYears Int      @default(0)
  consultationFee Float    @default(0)
  available       Boolean  @default(true)
  schedule        String?  // JSON schedule
  bio             String?
  licenseNumber   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments Appointment[]
  admissions   Admission[]
}

model Nurse {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String? @db.ObjectId
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ward        String?
  shift       String   @default("DAY") // DAY | NIGHT | ROTATING
  licenseNo   String?
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Employee {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String?  @db.ObjectId
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employeeNo   String?  @unique
  designation  String?
  joiningDate  DateTime?
  salary       Float    @default(0)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Room {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  number       String   @unique
  name         String?
  type         String   @default("GENERAL") // ICU | GENERAL | PRIVATE | SEMI_PRIVATE | OT
  floor        Int      @default(1)
  capacity     Int      @default(2)
  ratePerDay   Float    @default(0)
  status       String   @default("AVAILABLE")
  departmentId String?  @db.ObjectId
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  beds Bed[]

  @@index([status])
}

model Bed {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  number         String   @unique
  roomId         String   @db.ObjectId
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  status         String   @default("AVAILABLE") // AVAILABLE | OCCUPIED | RESERVED | CLEANING
  patientId      String?  @db.ObjectId
  currentAdmissionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  admissions Admission[]

  @@index([status])
}

model Admission {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  admissionNo   String   @unique // e.g. IPD-0001
  patientId     String   @db.ObjectId
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bedId         String?  @db.ObjectId
  bed           Bed?     @relation(fields: [bedId], references: [id], onDelete: SetNull)
  doctorId      String?  @db.ObjectId
  doctor        Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  admittedAt    DateTime @default(now())
  dischargeAt   DateTime?
  status        String   @default("ADMITTED") // ADMITTED | TRANSFERRED | DISCHARGED
  reason        String?
  diagnosis     String?
  notes         String?
  hospitalId    String?  @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([patientId])
  @@index([status])
}

model RefreshToken {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  replacedByToken String?
  userAgent       String?
  ipAddress       String?
}

// ============================================================================
// RBAC
// ============================================================================

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique // SUPER_ADMIN | HOSPITAL_ADMIN | DOCTOR | ...
  label       String
  description String?
  isSystem    Boolean  @default(false)
  hospitalId  String?  @db.ObjectId
  hospital    Hospital? @relation(fields: [hospitalId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  key             String   @unique // e.g. patients:read
  label           String
  module          String   // patients | billing | pharmacy | ...
  createdAt       DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String     @db.ObjectId
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.ObjectId
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ============================================================================
// System
// ============================================================================

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // LOGIN | LOGOUT | USER_CREATED | PATIENT_CREATED | ...
  entity    String?
  entityId  String?
  meta      String?  // JSON string payload
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model Settings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  hospitalId String  @db.ObjectId
  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  key       String
  value     String   // JSON-encoded
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, key])
}